    // -------------------------------------------------------------------
    // Sintaxe só em cinza: o destaque vem do peso (negrito) e do estilo
    // (itálico), nunca de cor.
    //   #2B2A27  forte    palavras-chave e nomes declarados (negrito)
    //   #3B3A36  base     código comum, variáveis, chamadas
    //   #4A4843  tipo     classes e tipos (itálico)
    //   #6E6A63  texto    strings
    //   #7A766E  miúdo    pontuação e operadores
    //   #8C877E  nota     comentários (itálico)
    // -------------------------------------------------------------------
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "class.declaration":     { "foreground": "#2B2A27", "bold": true, "italic": false },
        "interface.declaration": { "foreground": "#2B2A27", "bold": true, "italic": false },
        "enum.declaration":      { "foreground": "#2B2A27", "bold": true, "italic": false },
        "type.declaration":      { "foreground": "#2B2A27", "bold": true, "italic": false },
        "function.declaration":  { "foreground": "#2B2A27", "bold": true },
        "method.declaration":    { "foreground": "#2B2A27", "bold": true },
        "class":                 { "foreground": "#4A4843", "italic": true },
        "interface":             { "foreground": "#4A4843", "italic": true },
        "enum":                  { "foreground": "#4A4843", "italic": true },
        "type":                  { "foreground": "#4A4843", "italic": true },
        "typeParameter":         { "foreground": "#4A4843", "italic": true },
        "namespace":             { "foreground": "#4A4843" },
        "function":              "#3B3A36",
        "method":                "#3B3A36",
        "variable":              "#3B3A36",
        "parameter":             "#3B3A36",
        "property":              "#3B3A36",
        "enumMember":            "#4A4843",
        "decorator":             { "foreground": "#6E6A63", "italic": true }
    },
    "tokenColors": [
        // Base
        {
            "scope": ["source", "variable", "entity.name", "keyword", "storage", "support.function", "meta.function-call"],
            "settings": { "foreground": "#3B3A36" }
        },

        // Pontuação e operadores: recuam para o código respirar
        {
            "scope": [
                "punctuation",
                "meta.brace",
                "keyword.operator",
                "storage.type.function.arrow",
                "punctuation.definition.variable"
            ],
            "settings": { "foreground": "#7A766E" }
        },

        // Strings
        {
            "scope": ["string", "string.quoted", "string.template", "string.unquoted"],
            "settings": { "foreground": "#6E6A63" }
        },
        {
            "scope": ["punctuation.definition.string", "string punctuation.definition.string"],
            "settings": { "foreground": "#8C877E" }
        },
        {
            "scope": ["constant.character.escape", "constant.other.placeholder", "string.regexp"],
            "settings": { "foreground": "#4A4843" }
        },
        {
            "scope": [
                "meta.embedded",
                "meta.template.expression",
                "punctuation.definition.template-expression",
                "punctuation.section.embedded",
                "string variable"
            ],
            "settings": { "foreground": "#3B3A36" }
        },

        // Comentários: itálico, recuados
        {
            "scope": [
                "comment",
                "punctuation.definition.comment",
                "string.quoted.docstring",
                "string.quoted.docstring punctuation.definition.string"
            ],
            "settings": { "foreground": "#8C877E", "fontStyle": "italic" }
        },
        // @param, @return, @var... dentro do comentário
        {
            "scope": [
                "comment keyword",
                "comment storage.type",
                "keyword.other.phpdoc",
                "comment.block.documentation keyword",
                "comment.block.documentation storage.type",
                "storage.type.class.jsdoc",
                "punctuation.definition.block.tag.jsdoc"
            ],
            "settings": { "foreground": "#6E6A63", "fontStyle": "bold italic" }
        },
        {
            "scope": [
                "comment keyword.other.type",
                "comment support.class",
                "comment entity.name.type",
                "comment variable",
                "comment punctuation",
                "comment keyword.operator"
            ],
            "settings": { "foreground": "#8C877E", "fontStyle": "italic" }
        },

        // Palavras-chave: negrito forte
        {
            "scope": [
                "keyword.control",
                "keyword.other.new",
                "keyword.operator.new",
                "keyword.operator.expression",
                "keyword.operator.logical.python",
                "keyword.operator.wordlike",
                "keyword.other.use",
                "keyword.other.namespace",
                "keyword.other.import",
                "keyword.import",
                "keyword.package",
                "keyword.function",
                "keyword.const",
                "keyword.var",
                "keyword.type",
                "keyword.other.fn",
                "keyword.other.rust",
                "keyword.other.where",
                "keyword.other.special-method",
                "storage.type",
                "storage.modifier",
                "storage.type.function",
                "storage.type.class",
                "storage.type.interface",
                "storage.type.enum",
                "storage.type.trait",
                "storage.type.namespace",
                "storage.type.import",
                "storage.type.property",
                "storage.type.type",
                "storage.type.js",
                "storage.type.ts",
                "storage.type.tsx",
                "storage.type.rust",
                "support.type.object.module",
                "variable.language.super"
            ],
            "settings": { "foreground": "#2B2A27", "fontStyle": "bold" }
        },

        // Nomes declarados (função, método, classe): negrito forte
        {
            "scope": [
                "meta.function.php entity.name.function",
                "meta.function.python entity.name.function",
                "meta.definition.method entity.name.function",
                "meta.definition.function entity.name.function",
                "entity.name.type.class",
                "entity.name.type.interface",
                "entity.name.type.enum",
                "entity.name.type.trait",
                "entity.name.type.alias",
                "entity.name.class",
                "entity.name.section"
            ],
            "settings": { "foreground": "#2B2A27", "fontStyle": "bold" }
        },

        // Tipos e classes usados: itálico
        {
            "scope": [
                "support.class",
                "support.type",
                "entity.name.type",
                "entity.other.inherited-class",
                "keyword.other.type",
                "storage.type.php",
                "storage.type.primitive",
                "storage.type.built-in",
                "storage.type.java",
                "storage.type.cs",
                "support.type.primitive",
                "support.type.builtin",
                "entity.name.namespace",
                "support.other.namespace"
            ],
            "settings": { "foreground": "#4A4843", "fontStyle": "italic" }
        },
        {
            "scope": ["entity.name.namespace", "entity.name.type.namespace", "support.other.namespace", "punctuation.separator.inheritance"],
            "settings": { "foreground": "#4A4843", "fontStyle": "" }
        },

        // $this, self, this, null, true, false
        {
            "scope": [
                "variable.language",
                "constant.language",
                "storage.type.string.python"
            ],
            "settings": { "foreground": "#4A4843", "fontStyle": "italic" }
        },
        // Constantes (MODELO_MDFE) e números
        {
            "scope": ["constant.other", "variable.other.constant", "variable.other.enummember", "constant.numeric"],
            "settings": { "foreground": "#4A4843" }
        },

        // Decorators / atributos (#[...], @decorator)
        {
            "scope": [
                "meta.decorator",
                "meta.attribute.php",
                "entity.name.function.decorator",
                "punctuation.definition.decorator"
            ],
            "settings": { "foreground": "#6E6A63", "fontStyle": "italic" }
        },

        // Chaves de JSON, YAML, CSS: base, sem itálico
        {
            "scope": [
                "support.type.property-name",
                "entity.name.tag.yaml",
                "meta.object-literal.key",
                "variable.other.env"
            ],
            "settings": { "foreground": "#3B3A36", "fontStyle": "" }
        },

        // HTML / JSX / Blade / XML: tudo normal, sem negrito nem itálico
        {
            "scope": [
                "entity.name.tag",
                "support.class.component",
                "entity.name.tag support.class",
                "meta.tag.sgml.doctype",
                "entity.other.attribute-name",
                "entity.other.attribute-name.class",
                "entity.other.attribute-name.id",
                "meta.tag entity.other.attribute-name"
            ],
            "settings": { "foreground": "#3B3A36", "fontStyle": "" }
        },

        // Markdown
        {
            "scope": ["markup.heading", "markup.heading entity.name", "markup.bold"],
            "settings": { "foreground": "#2B2A27", "fontStyle": "bold" }
        },
        {
            "scope": ["markup.italic", "markup.quote"],
            "settings": { "foreground": "#4A4843", "fontStyle": "italic" }
        },
        {
            "scope": ["markup.inline.raw", "markup.fenced_code", "markup.raw"],
            "settings": { "foreground": "#6E6A63" }
        },
        {
            "scope": ["markup.underline.link", "string.other.link"],
            "settings": { "foreground": "#4A4843", "fontStyle": "underline" }
        },

        // Diff (arquivos .diff / .patch): sem verde e vermelho
        {
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#2B2A27", "fontStyle": "bold" }
        },
        {
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#8C877E", "fontStyle": "italic" }
        },
        {
            "scope": ["markup.changed", "meta.diff.header"],
            "settings": { "foreground": "#4A4843", "fontStyle": "italic" }
        },

        // Erro de sintaxe: sublinhado, sem vermelho
        {
            "scope": ["invalid", "invalid.illegal", "invalid.deprecated"],
            "settings": { "foreground": "#2B2A27", "fontStyle": "underline" }
        }
    ]
}
